# ---- Zoho Books API (read-only). Copy this file to ".env" and fill in. NEVER commit .env or paste its values in chat. ----
# Data centre: in = India (zoho.in). Your org id is already filled in.
ZOHO_DC=in
ZOHO_ORG_ID=60038956413
# From Zoho API Console (api-console.zoho.in) -> your Self Client -> "Client Secret" tab
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Filled in automatically by:  npm run zoho:token
ZOHO_REFRESH_TOKEN=
# ---- Redis (reuse the existing database) - used in a later step ----
REDIS_URL=
